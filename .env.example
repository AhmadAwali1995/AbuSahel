# Server-side voice pipeline — copy to .env (gitignored). Never commit API keys.

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_STT_MODEL=gpt-transcribe

# RAG / Ask API (used by /api/ask-stream in server/voiceApi.js)
RAG_API_URL=https://faqragsystem-production-88c2.up.railway.app/v1/messages?wait=60&format=json
# RAG_API_BEARER_TOKEN=
# RAG_API_EXTRA_JSON={"session_id":"demo-user"}
# RAG_API_TIMEOUT_SECONDS=60

ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_TTS_VOICE_ID=oJCdZCYaJobw2GlrIQm5

ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Browser-side (optional — voice pipeline uses server routes above)
# VITE_GEMINI_API_KEY=your_gemini_api_key_here
# VITE_ASK_API_URL=https://faqragsystem-production-88c2.up.railway.app/v1/messages?wait=60&format=json
